# WorthASlab — environment variables (server-side only)
# Copy to .env.local for local dev. In Vercel: Project Settings → Environment Variables.
# NEVER commit real keys. NEVER expose these to client-side code.

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
# Set after deploying to Vercel (must be the public webhook URL):
NOWPAYMENTS_IPN_CALLBACK_URL=https://your-domain.com/api/webhooks/nowpayments

# Site
SITE_URL=https://your-domain.com

# Supabase (fill in when backend is wired)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Price ingestion (placeholders only — user pastes real keys into Vercel env at deploy)
OPENSEA_API_KEY=
COURTYARD_CONTRACT_ADDRESS=
COURTYARD_COLLECTION_SLUG=
EBAY_API_KEY=
CRON_SECRET=
